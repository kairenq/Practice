<Window x:Class="AdmissionSystem.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация - Приемная комиссия БППК" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <TextBlock Text="Регистрация абитуриента" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       HorizontalAlignment="Center" Foreground="White"/>
        </materialDesign:ColorZone>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <materialDesign:Card Margin="20" Padding="32">
                <StackPanel>
                    <TextBlock Text="Личные данные" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,16"/>

                    <TextBox x:Name="LastNameTextBox"
                             materialDesign:HintAssist.Hint="Фамилия *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <TextBox x:Name="FirstNameTextBox"
                             materialDesign:HintAssist.Hint="Имя *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <TextBox x:Name="PatronymicTextBox"
                             materialDesign:HintAssist.Hint="Отчество"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <DatePicker x:Name="DateOfBirthPicker"
                                materialDesign:HintAssist.Hint="Дата рождения"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Margin="0,0,0,12"/>

                    <TextBox x:Name="PassportTextBox"
                             materialDesign:HintAssist.Hint="Серия и номер паспорта"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <TextBox x:Name="AddressTextBox"
                             materialDesign:HintAssist.Hint="Адрес проживания"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,24"/>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Данные для входа" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,16"/>

                    <TextBox x:Name="EmailTextBox"
                             materialDesign:HintAssist.Hint="Email *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <PasswordBox x:Name="PasswordBox"
                                 materialDesign:HintAssist.Hint="Пароль *"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Margin="0,0,0,12"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 materialDesign:HintAssist.Hint="Подтверждение пароля *"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Margin="0,0,0,24"/>

                    <Button x:Name="RegisterButton"
                            Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                            Click="RegisterButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Margin="0,0,0,12"/>

                    <Button x:Name="BackButton"
                            Content="НАЗАД К ВХОДУ"
                            Click="BackButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40"/>

                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </materialDesign:Card>
        </ScrollViewer>
    </Grid>
</Window>
