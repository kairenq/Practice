<Window x:Class="AdmissionSystem.Windows.ReviewApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Рассмотрение заявки" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    <ScrollViewer>
        <Grid Margin="20">
            <materialDesign:Card Padding="32">
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Информация об абитуриенте" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="UserInfoTextBlock" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Программа обучения" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ProgramInfoTextBlock" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Данные заявки" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ApplicationInfoTextBlock" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <Separator Margin="0,0,0,24"/>

                    <TextBlock Text="Изменить статус" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,16"/>

                    <ComboBox x:Name="StatusComboBox"
                              materialDesign:HintAssist.Hint="Новый статус"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,16"/>

                    <TextBox x:Name="ReviewCommentsTextBox"
                             materialDesign:HintAssist.Hint="Комментарий"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinLines="3"
                             Margin="0,0,0,16"/>

                    <Button x:Name="UpdateButton"
                            Content="ОБНОВИТЬ СТАТУС"
                            Click="UpdateButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Margin="0,0,0,8"/>

                    <Button Content="ЗАКРЫТЬ"
                            Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</Window>
