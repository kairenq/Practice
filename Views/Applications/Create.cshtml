@model AdmissionSystem.ViewModels.CreateApplicationViewModel
@{
    ViewData["Title"] = "Подать заявку";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title mb-4">Подать заявку на обучение</h2>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ProgramId" class="form-label"></label>
                        <select asp-for="ProgramId" class="form-select" asp-items="ViewBag.Programs">
                            <option value="">-- Выберите программу --</option>
                        </select>
                        <span asp-validation-for="ProgramId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EducationInfo" class="form-label"></label>
                        <textarea asp-for="EducationInfo" class="form-control" rows="3"
                                  placeholder="Например: Окончил школу №1 в 2024 году"></textarea>
                        <span asp-validation-for="EducationInfo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExamScore" class="form-label"></label>
                        <input asp-for="ExamScore" class="form-control" type="number" step="0.01" min="0" max="5"
                               placeholder="Например: 4.5" />
                        <span asp-validation-for="ExamScore" class="text-danger"></span>
                        <small class="form-text text-muted">Введите средний балл аттестата</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Comments" class="form-label"></label>
                        <textarea asp-for="Comments" class="form-control" rows="4"
                                  placeholder="Дополнительная информация, достижения, награды и т.д."></textarea>
                        <span asp-validation-for="Comments" class="text-danger"></span>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <strong>Обратите внимание:</strong> Заявка будет создана в статусе "Черновик".
                        Вы сможете отредактировать её перед отправкой.
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Создать заявку</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
