@model AdmissionSystem.Models.AdmissionApplication
@{
    ViewData["Title"] = "Детали заявки";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Заявка №@Model.Id</h3>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Информация о заявке</h5>
                        <table class="table table-sm">
                            <tr>
                                <th>Статус:</th>
                                <td>
                                    @switch (Model.Status)
                                    {
                                        case AdmissionSystem.Models.ApplicationStatus.Draft:
                                            <span class="badge bg-secondary">Черновик</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Submitted:
                                            <span class="badge bg-primary">Подана</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.UnderReview:
                                            <span class="badge bg-info">На рассмотрении</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Accepted:
                                            <span class="badge bg-success">Принята</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Rejected:
                                            <span class="badge bg-danger">Отклонена</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Withdrawn:
                                            <span class="badge bg-warning">Отозвана</span>
                                            break;
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Дата создания:</th>
                                <td>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <tr>
                                    <th>Последнее изменение:</th>
                                    <td>@Model.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Информация об абитуриенте</h5>
                        <table class="table table-sm">
                            <tr>
                                <th>ФИО:</th>
                                <td>@Model.User.LastName @Model.User.FirstName @Model.User.Patronymic</td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td>@Model.User.Email</td>
                            </tr>
                            @if (Model.User.DateOfBirth.HasValue)
                            {
                                <tr>
                                    <th>Дата рождения:</th>
                                    <td>@Model.User.DateOfBirth.Value.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <hr>

                <h5>Образовательная программа</h5>
                <div class="alert alert-light">
                    <h6>@Model.Program.Name</h6>
                    <p class="mb-1"><strong>Код:</strong> @Model.Program.Code</p>
                    <p class="mb-1"><strong>Уровень:</strong> @Model.Program.EducationLevel</p>
                    <p class="mb-0"><strong>Срок обучения:</strong> @Model.Program.DurationYears года</p>
                </div>

                <hr>

                <h5>Дополнительная информация</h5>
                <div class="mb-3">
                    <strong>Предыдущее образование:</strong>
                    <p>@(Model.EducationInfo ?? "Не указано")</p>
                </div>

                <div class="mb-3">
                    <strong>Средний балл аттестата:</strong>
                    <p>@(Model.ExamScore?.ToString("F2") ?? "Не указано")</p>
                </div>

                <div class="mb-3">
                    <strong>Комментарии:</strong>
                    <p>@(Model.Comments ?? "Нет комментариев")</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ReviewedBy))
                {
                    <hr>
                    <div class="alert alert-info">
                        <strong>Проверено:</strong> @Model.ReviewedBy
                        @if (Model.ReviewedAt.HasValue)
                        {
                            <span>(@Model.ReviewedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</span>
                        }
                    </div>
                }
            </div>
            <div class="card-footer">
                @if (User.IsInRole("Applicant") && Model.Status == AdmissionSystem.Models.ApplicationStatus.Draft)
                {
                    <form asp-controller="Applications" asp-action="Submit" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-success" onclick="return confirm('Подать заявку?')">Подать заявку</button>
                    </form>
                    <form asp-controller="Applications" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Удалить заявку?')">Удалить</button>
                    </form>
                }
                <a asp-controller="Applications" asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>
