@model IEnumerable<AdmissionSystem.Models.AdmissionApplication>
@{
    ViewData["Title"] = "Мои заявки";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Мои заявки</h2>
    <a asp-action="Create" class="btn btn-success">Подать новую заявку</a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>№</th>
                    <th>Программа</th>
                    <th>Статус</th>
                    <th>Дата подачи</th>
                    <th>Средний балл</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in Model)
                {
                    <tr>
                        <td>@application.Id</td>
                        <td>@application.Program.Name</td>
                        <td>
                            @switch (application.Status)
                            {
                                case AdmissionSystem.Models.ApplicationStatus.Draft:
                                    <span class="badge bg-secondary">Черновик</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Submitted:
                                    <span class="badge bg-primary">Подана</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.UnderReview:
                                    <span class="badge bg-info">На рассмотрении</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Accepted:
                                    <span class="badge bg-success">Принята</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Rejected:
                                    <span class="badge bg-danger">Отклонена</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Withdrawn:
                                    <span class="badge bg-warning">Отозвана</span>
                                    break;
                            }
                        </td>
                        <td>@application.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(application.ExamScore?.ToString("F2") ?? "-")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@application.Id" class="btn btn-sm btn-info">Подробнее</a>
                            @if (application.Status == AdmissionSystem.Models.ApplicationStatus.Draft)
                            {
                                <form asp-action="Submit" asp-route-id="@application.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Подать заявку?')">Подать</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@application.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить заявку?')">Удалить</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">У вас пока нет заявок</h4>
        <p>Подайте заявку на обучение по одной из наших образовательных программ</p>
        <hr>
        <a asp-action="Create" class="btn btn-success">Подать заявку</a>
    </div>
}
