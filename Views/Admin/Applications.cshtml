@model IEnumerable<AdmissionSystem.Models.AdmissionApplication>
@{
    ViewData["Title"] = "Все заявки";
}

<h2 class="mb-4">Все заявки</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Фильтр по статусу</h5>
        <div class="btn-group" role="group">
            <a asp-action="Applications" class="btn btn-outline-primary @(ViewBag.SelectedStatus == null ? "active" : "")">Все</a>
            <a asp-action="Applications" asp-route-status="@AdmissionSystem.Models.ApplicationStatus.Submitted"
               class="btn btn-outline-primary @(ViewBag.SelectedStatus == AdmissionSystem.Models.ApplicationStatus.Submitted ? "active" : "")">Подана</a>
            <a asp-action="Applications" asp-route-status="@AdmissionSystem.Models.ApplicationStatus.UnderReview"
               class="btn btn-outline-info @(ViewBag.SelectedStatus == AdmissionSystem.Models.ApplicationStatus.UnderReview ? "active" : "")">На рассмотрении</a>
            <a asp-action="Applications" asp-route-status="@AdmissionSystem.Models.ApplicationStatus.Accepted"
               class="btn btn-outline-success @(ViewBag.SelectedStatus == AdmissionSystem.Models.ApplicationStatus.Accepted ? "active" : "")">Принята</a>
            <a asp-action="Applications" asp-route-status="@AdmissionSystem.Models.ApplicationStatus.Rejected"
               class="btn btn-outline-danger @(ViewBag.SelectedStatus == AdmissionSystem.Models.ApplicationStatus.Rejected ? "active" : "")">Отклонена</a>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow">
            <thead class="table-dark">
                <tr>
                    <th>№</th>
                    <th>Абитуриент</th>
                    <th>Email</th>
                    <th>Программа</th>
                    <th>Средний балл</th>
                    <th>Статус</th>
                    <th>Дата подачи</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in Model)
                {
                    <tr>
                        <td>@application.Id</td>
                        <td>@application.User.LastName @application.User.FirstName @application.User.Patronymic</td>
                        <td>@application.User.Email</td>
                        <td>@application.Program.Name</td>
                        <td>@(application.ExamScore?.ToString("F2") ?? "-")</td>
                        <td>
                            @switch (application.Status)
                            {
                                case AdmissionSystem.Models.ApplicationStatus.Draft:
                                    <span class="badge bg-secondary">Черновик</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Submitted:
                                    <span class="badge bg-primary">Подана</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.UnderReview:
                                    <span class="badge bg-info">На рассмотрении</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Accepted:
                                    <span class="badge bg-success">Принята</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Rejected:
                                    <span class="badge bg-danger">Отклонена</span>
                                    break;
                                case AdmissionSystem.Models.ApplicationStatus.Withdrawn:
                                    <span class="badge bg-warning">Отозвана</span>
                                    break;
                            }
                        </td>
                        <td>@application.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <a asp-action="ReviewApplication" asp-route-id="@application.Id" class="btn btn-sm btn-primary">Рассмотреть</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        Нет заявок для отображения
    </div>
}
