@model AdmissionSystem.Models.AdmissionApplication
@{
    ViewData["Title"] = "Рассмотрение заявки";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Рассмотрение заявки №@Model.Id</h3>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Информация об абитуриенте</h5>
                        <table class="table table-sm">
                            <tr>
                                <th>ФИО:</th>
                                <td>@Model.User.LastName @Model.User.FirstName @Model.User.Patronymic</td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td>@Model.User.Email</td>
                            </tr>
                            <tr>
                                <th>Телефон:</th>
                                <td>@(Model.User.PhoneNumber ?? "Не указан")</td>
                            </tr>
                            @if (Model.User.DateOfBirth.HasValue)
                            {
                                <tr>
                                    <th>Дата рождения:</th>
                                    <td>@Model.User.DateOfBirth.Value.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.User.PassportNumber))
                            {
                                <tr>
                                    <th>Паспорт:</th>
                                    <td>@Model.User.PassportNumber</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.User.Address))
                            {
                                <tr>
                                    <th>Адрес:</th>
                                    <td>@Model.User.Address</td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Информация о заявке</h5>
                        <table class="table table-sm">
                            <tr>
                                <th>Текущий статус:</th>
                                <td>
                                    @switch (Model.Status)
                                    {
                                        case AdmissionSystem.Models.ApplicationStatus.Draft:
                                            <span class="badge bg-secondary">Черновик</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Submitted:
                                            <span class="badge bg-primary">Подана</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.UnderReview:
                                            <span class="badge bg-info">На рассмотрении</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Accepted:
                                            <span class="badge bg-success">Принята</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Rejected:
                                            <span class="badge bg-danger">Отклонена</span>
                                            break;
                                        case AdmissionSystem.Models.ApplicationStatus.Withdrawn:
                                            <span class="badge bg-warning">Отозвана</span>
                                            break;
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Дата создания:</th>
                                <td>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <tr>
                                    <th>Последнее изменение:</th>
                                    <td>@Model.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.ReviewedBy))
                            {
                                <tr>
                                    <th>Проверено:</th>
                                    <td>@Model.ReviewedBy</td>
                                </tr>
                            }
                            @if (Model.ReviewedAt.HasValue)
                            {
                                <tr>
                                    <th>Дата проверки:</th>
                                    <td>@Model.ReviewedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <hr>

                <h5>Образовательная программа</h5>
                <div class="alert alert-light">
                    <h6>@Model.Program.Name</h6>
                    <p class="mb-1"><strong>Код:</strong> @Model.Program.Code</p>
                    <p class="mb-1"><strong>Описание:</strong> @Model.Program.Description</p>
                    <p class="mb-1"><strong>Уровень:</strong> @Model.Program.EducationLevel</p>
                    <p class="mb-1"><strong>Срок обучения:</strong> @Model.Program.DurationYears года</p>
                    <p class="mb-0"><strong>Доступно мест:</strong> @Model.Program.PlacesCount</p>
                </div>

                <hr>

                <h5>Академическая информация</h5>
                <div class="mb-3">
                    <strong>Предыдущее образование:</strong>
                    <p>@(Model.EducationInfo ?? "Не указано")</p>
                </div>

                <div class="mb-3">
                    <strong>Средний балл аттестата:</strong>
                    <p class="@(Model.ExamScore >= 4.5m ? "text-success" : Model.ExamScore >= 4.0m ? "text-info" : "text-warning")">
                        @(Model.ExamScore?.ToString("F2") ?? "Не указано")
                    </p>
                </div>

                <div class="mb-3">
                    <strong>Дополнительная информация:</strong>
                    <p>@(Model.Comments ?? "Нет комментариев")</p>
                </div>

                <hr>

                <h5>Изменить статус заявки</h5>
                <form asp-action="UpdateStatus" method="post" class="mt-3">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="status" class="form-label">Новый статус</label>
                            <select name="status" id="status" class="form-select">
                                <option value="@AdmissionSystem.Models.ApplicationStatus.Submitted" selected="@(Model.Status == AdmissionSystem.Models.ApplicationStatus.Submitted)">Подана</option>
                                <option value="@AdmissionSystem.Models.ApplicationStatus.UnderReview" selected="@(Model.Status == AdmissionSystem.Models.ApplicationStatus.UnderReview)">На рассмотрении</option>
                                <option value="@AdmissionSystem.Models.ApplicationStatus.Accepted" selected="@(Model.Status == AdmissionSystem.Models.ApplicationStatus.Accepted)">Принята</option>
                                <option value="@AdmissionSystem.Models.ApplicationStatus.Rejected" selected="@(Model.Status == AdmissionSystem.Models.ApplicationStatus.Rejected)">Отклонена</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="comments" class="form-label">Комментарий (необязательно)</label>
                            <textarea name="comments" id="comments" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Обновить статус</button>
                    </div>
                </form>
            </div>
            <div class="card-footer">
                <a asp-action="Applications" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>
