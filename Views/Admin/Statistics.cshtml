@{
    ViewData["Title"] = "Статистика";
}

<h2 class="mb-4">Статистика приемной комиссии</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3 shadow">
            <div class="card-body text-center">
                <h5 class="card-title">Всего заявок</h5>
                <p class="display-4">@ViewBag.TotalApplications</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3 shadow">
            <div class="card-body text-center">
                <h5 class="card-title">Поданные</h5>
                <p class="display-4">@ViewBag.SubmittedApplications</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3 shadow">
            <div class="card-body text-center">
                <h5 class="card-title">Принятые</h5>
                <p class="display-4">@ViewBag.AcceptedApplications</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3 shadow">
            <div class="card-body text-center">
                <h5 class="card-title">Отклоненные</h5>
                <p class="display-4">@ViewBag.RejectedApplications</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Статистика по программам</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Программа</th>
                        <th>Код</th>
                        <th>Всего заявок</th>
                        <th>Принято</th>
                        <th>Доступно мест</th>
                        <th>Заполнено, %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in ViewBag.ProgramStats)
                    {
                        var fillPercentage = stat.Program.PlacesCount > 0
                            ? (stat.AcceptedCount * 100.0 / stat.Program.PlacesCount)
                            : 0;
                        var progressClass = fillPercentage >= 100 ? "bg-danger" : fillPercentage >= 75 ? "bg-warning" : "bg-success";

                        <tr>
                            <td>@stat.Program.Name</td>
                            <td>@stat.Program.Code</td>
                            <td>@stat.ApplicationCount</td>
                            <td>@stat.AcceptedCount</td>
                            <td>@stat.Program.PlacesCount</td>
                            <td>
                                <div class="progress">
                                    <div class="progress-bar @progressClass" role="progressbar"
                                         style="width: @(Math.Min(fillPercentage, 100))%"
                                         aria-valuenow="@fillPercentage" aria-valuemin="0" aria-valuemax="100">
                                        @fillPercentage.ToString("F1")%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
